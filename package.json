{
	"name": "photographer-proof-hub",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/node": "^22.20.1",
			"@cloudflare/workers-types": "^5.20260728.1",
			"hono": "^4.12.32",
			"@orpc/server": "^1.14.12",
			"@orpc/openapi": "^1.14.12",
			"@orpc/zod": "^1.14.12",
			"better-auth": "1.6.27",
			"lucide-react": "^1.27.0",
			"@icons-pack/react-simple-icons": "^13.15.1",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"tailwindcss": "^4.3.3",
			"@orpc/client": "^1.14.12",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @photographer-proof-hub/db --",
		"db:studio": "turbo run db:studio -F @photographer-proof-hub/db --",
		"db:generate": "turbo run db:generate -F @photographer-proof-hub/db --",
		"db:seed": "turbo run db:seed -F @photographer-proof-hub/db --",
		"db:migrate": "turbo run db:migrate -F @photographer-proof-hub/db --",
		"deploy": "turbo run deploy -F @photographer-proof-hub/infra --",
		"destroy": "turbo run destroy -F @photographer-proof-hub/infra --",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@photographer-proof-hub/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@cloudflare/workers-types": "catalog:",
		"@photographer-proof-hub/config": "workspace:*",
		"@types/node": "catalog:",
		"lefthook": "^2.1.10",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.12"
}
